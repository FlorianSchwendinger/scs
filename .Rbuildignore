^\.git.*
^\.Rhistory$
^README\.html$
^Makefile$
^Taskfile\.yml$
^scs_.*\.tar\.gz$
# Developer tooling that regenerates inst/tinytest/problem_results, see
# tools/upstream_tests/README.md. Never part of the built package. Every line
# of this file is a regular expression, comments included.
^tools$

# Bundled SCS (src/scs, upstream tag 3.3.1): ship only what the static
# archive out/libscsdir.a compiles. Everything below is documentation, tests,
# alternative linear-system back ends, or the experimental spectral cones,
# none of which the R package builds.
^src/scs/\.git.*
^src/scs/\.github$
^src/scs/\.bumpversion\.cfg$
^src/scs/CITATION\.cff$
^src/scs/CLAUDE\.md$
^src/scs/CMakeLists\.txt$
^src/scs/CONTRIBUTING\.md$
^src/scs/README\.md$
^src/scs/cmake$
^src/scs/docs$
^src/scs/test$
^src/scs/linsys/gpu$
^src/scs/linsys/mkl$
^src/scs/linsys/cudss$
^src/scs/linsys/accelerate$
^src/scs/linsys/cpu/dense$
^src/scs/linsys/cpu/indirect$
^src/scs/src/spectral_cones$
